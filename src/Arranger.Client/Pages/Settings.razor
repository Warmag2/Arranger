@page "/settings"
@attribute [Authorize]
@inject ArrangerApi Api
@inject CurrentUser CurrentUser
@inject NavigationManager Navigation

<PageTitle>Settings · Arranger</PageTitle>

<h1>
    Settings
</h1>

@if (error != null)
{
    <div class="error">@error</div>
}

@if (message != null)
{
    <div class="success">@message</div>
}

@if (settings == null || timeZones == null)
{
    @if (error == null)
    {
        <p>
            Loading…
        </p>
    }
}
else
{
    <section>
        <h2>
            Profile picture
        </h2>

        <UserAvatar UserId="settings.UserId" Size="96" Revision="pictureRevision" />
        <div>
            <InputFile class="input-file" accept="@ProfilePictureRules.AcceptedContentTypes" OnChange="UploadPictureAsync" disabled="@busy" />
            @if (settings.HasProfilePicture)
            {
                <button class="button button-delete" disabled="@busy" @onclick="DeletePictureAsync">Remove picture</button>
            }
        </div>
    </section>

    <section>
        <h2>
            Profile
        </h2>

        <form @onsubmit="SaveAsync">
            <div class="form">
                <label class="label-text" for="handle">Handle</label>
                <input class="input-text" id="handle" maxlength="@AccountRules.UserNameMaxLength" @bind="userName" />
            </div>
            <div class="form form-select">
                <label class="label-text" for="time-zone">Time zone</label>
                <FormComboBox TItem="string" Options="@TimeZoneOption.Options(timeZones)" SelectedOption="@timeZoneId" OnChanged="@(id => timeZoneId = id)" />
            </div>
            <div class="form form-select">
                <label class="label-text" for="currency">Default currency for new arrangements</label>
                <FormComboBox TItem="string" Options="@Currencies.Options()" SelectedOption="@currency" OnChanged="@(code => currency = code)" />
            </div>
            <button type="submit" class="button button-submit" disabled="@busy">Save</button>
        </form>
    </section>

    <a href="Account/Manage/ChangePassword">Change password</a>
}

@code {
    private UserSettings? settings;
    private List<TimeZoneOption>? timeZones;
    private string userName = string.Empty;
    private string timeZoneId = string.Empty;
    private string currency = string.Empty;
    private string? error;
    private string? message;
    private bool busy;
    private int pictureRevision;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        settings = await CurrentUser.GetSettingsAsync();
        var zones = await Api.GetAsync<List<TimeZoneOption>>("api/time-zones");
        error = settings == null ? "The settings could not be loaded." : zones.Error;
        timeZones = zones.Value;
        if (settings == null || timeZones == null)
        {
            return;
        }

        userName = settings.UserName;
        timeZoneId = settings.TimeZoneId;
        currency = settings.DefaultCurrency;
        if (!timeZones.Exists(t => t.Id == timeZoneId))
        {
            timeZones.Insert(0, new TimeZoneOption(timeZoneId, timeZoneId));
        }
    }

    private async Task SaveAsync()
    {
        message = null;
        error = AccountRules.ValidateSettings(userName, timeZoneId, currency);
        if (error != null)
        {
            return;
        }

        busy = true;
        var result = await Api.SendAsync<UserSettings>(HttpMethod.Put, "api/me/settings", new UpdateUserSettingsRequest(userName, timeZoneId, currency));
        busy = false;
        if (!result.IsSuccess)
        {
            error = result.Error;
            return;
        }

        var renamed = result.Value.UserName != settings!.UserName;
        settings = result.Value;
        CurrentUser.Update(settings);
        if (renamed)
        {
            // The handle is also in the authentication state, which only a full reload refreshes.
            Navigation.Refresh(forceReload: true);
            return;
        }

        message = "Saved.";
    }

    private async Task UploadPictureAsync(InputFileChangeEventArgs e)
    {
        message = null;
        busy = true;
        try
        {
            var image = await e.File.RequestImageFileAsync("image/jpeg", ProfilePictureRules.UploadDimension, ProfilePictureRules.UploadDimension);
            if (image.Size > ProfilePictureRules.MaxBytes)
            {
                error = $"The picture must be at most {ProfilePictureRules.MaxBytes / 1024} KiB.";
                return;
            }

            var bytes = new byte[image.Size];
            await using (var stream = image.OpenReadStream(ProfilePictureRules.MaxBytes))
            {
                await stream.ReadExactlyAsync(bytes);
            }

            using var content = new ByteArrayContent(bytes);
            content.Headers.ContentType = new MediaTypeHeaderValue(image.ContentType);
            error = await Api.SendAsync(HttpMethod.Put, "api/me/picture", content);
            if (error == null)
            {
                SetHasPicture(true);
            }
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeletePictureAsync()
    {
        message = null;
        busy = true;
        error = await Api.SendAsync(HttpMethod.Delete, "api/me/picture");
        busy = false;
        if (error == null)
        {
            SetHasPicture(false);
        }
    }

    private void SetHasPicture(bool hasPicture)
    {
        settings = settings! with { HasProfilePicture = hasPicture };
        CurrentUser.Update(settings);
        pictureRevision++;
    }
}
