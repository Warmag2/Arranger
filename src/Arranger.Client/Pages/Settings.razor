@page "/settings"
@attribute [Authorize]
@inject ArrangerApi Api
@inject CurrentUser CurrentUser
@inject NavigationManager Navigation

<PageTitle>Profile · Arranger</PageTitle>

<h1>
    Profile
</h1>

@if (error != null)
{
    <div class="error">@error</div>
}

@if (message != null)
{
    <div class="success">@message</div>
}

@if (settings == null || timeZones == null)
{
    @if (error == null)
    {
        <p>
            Loading…
        </p>
    }
}
else
{
    <section>
        <h2>
            Profile picture
        </h2>

        <UserAvatar UserId="settings.UserId" UserName="@settings.UserName" PictureVersion="settings.PictureVersion" Size="96" />
        <div>
            <InputFile accept="@ProfilePictureRules.AcceptedContentTypes" OnChange="UploadPictureAsync" disabled="@busy" />
            @if (settings.PictureVersion != null)
            {
                <button class="button button-delete" disabled="@busy" @onclick="DeletePictureAsync">Remove picture</button>
            }
        </div>
        <p class="secondary">PNG, JPEG or WebP, up to @(ProfilePictureRules.MaxDimension)×@(ProfilePictureRules.MaxDimension) pixels. Larger pictures are scaled down automatically.</p>
    </section>

    <section>
        <h2>
            Personal settings
        </h2>

        <form @onsubmit="SaveAsync">
            <div class="form">
                <label for="username">Username</label>
                <input id="username" maxlength="@AccountRules.UserNameMaxLength" @bind="userName" />
            </div>
            <div class="form">
                <label for="time-zone">Time zone</label>
                <FormComboBox TItem="string" Id="time-zone" Options="@TimeZoneOption.Options(timeZones)" SelectedOption="@timeZoneId" OnChanged="@(id => timeZoneId = id)" />
            </div>
            <div class="form">
                <label for="currency">Default currency for new arrangements</label>
                <FormComboBox TItem="string" Id="currency" Options="@Currencies.Options()" SelectedOption="@currency" OnChanged="@(code => currency = code)" />
            </div>
            <button type="submit" class="button button-submit" disabled="@busy">Save</button>
        </form>
    </section>

    <a href="Account/Manage/ChangePassword">Change password</a>
}

@code {
    private UserSettings? settings;
    private List<TimeZoneOption>? timeZones;
    private string userName = string.Empty;
    private string timeZoneId = string.Empty;
    private string currency = string.Empty;
    private string? error;
    private string? message;
    private bool busy;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        settings = await CurrentUser.GetSettingsAsync();
        var zones = await Api.GetAsync<List<TimeZoneOption>>(ApiRoutes.TimeZones);
        error = settings == null ? "The settings could not be loaded." : zones.Error;
        timeZones = zones.Value;
        if (settings == null || timeZones == null)
        {
            return;
        }

        userName = settings.UserName;
        timeZoneId = settings.TimeZoneId;
        currency = settings.DefaultCurrency;
        if (!timeZones.Exists(t => t.Id == timeZoneId))
        {
            timeZones.Insert(0, new TimeZoneOption(timeZoneId, timeZoneId));
        }
    }

    private async Task SaveAsync()
    {
        message = null;
        error = AccountRules.ValidateSettings(userName, timeZoneId, currency);
        if (error != null)
        {
            return;
        }

        busy = true;
        ApiResult<UserSettings> result;
        try
        {
            result = await Api.SendAsync<UserSettings>(HttpMethod.Put, ApiRoutes.MySettings, new UpdateUserSettingsRequest(userName, timeZoneId, currency));
        }
        finally
        {
            busy = false;
        }

        if (!result.IsSuccess)
        {
            error = result.Error;
            return;
        }

        var renamed = result.Value.UserName != settings!.UserName;
        Apply(result.Value);
        if (renamed)
        {
            // The username is also in the authentication state, which only a full reload refreshes.
            Navigation.Refresh(forceReload: true);
            return;
        }

        message = "Saved.";
    }

    private async Task UploadPictureAsync(InputFileChangeEventArgs e)
    {
        message = null;
        busy = true;
        try
        {
            var picture = await PrepareUploadAsync(e.File);
            if (picture == null)
            {
                error = $"The picture must be at most {ProfilePictureRules.MaxBytes / 1024} KiB.";
                return;
            }

            using var content = new ByteArrayContent(picture.Value.Bytes);
            content.Headers.ContentType = new MediaTypeHeaderValue(picture.Value.ContentType);
            Apply(await Api.SendAsync<UserSettings>(HttpMethod.Put, ApiRoutes.MyPicture, content));
        }
        finally
        {
            busy = false;
        }
    }

    private static async Task<(byte[] Bytes, string ContentType)?> PrepareUploadAsync(IBrowserFile file)
    {
        // A picture already in an accepted format and within both the byte and pixel limits is uploaded as-is, keeping
        // its exact quality and any transparency.
        if (file.ContentType is ProfilePictureRules.Png or ProfilePictureRules.Jpeg or ProfilePictureRules.Webp && file.Size <= ProfilePictureRules.MaxBytes)
        {
            var original = await ReadBytesAsync(file);
            if (ProfilePictureRules.ReadDimensions(original) is { } size
                && size.Width <= ProfilePictureRules.MaxDimension
                && size.Height <= ProfilePictureRules.MaxDimension)
            {
                return (original, file.ContentType);
            }
        }

        // Anything larger (big phone photos and the like) is scaled down to the upload size and re-encoded, so it is
        // accepted rather than rejected. WebP and PNG keep an alpha channel, so re-encode them back to themselves;
        // everything else becomes JPEG.
        var format = file.ContentType is ProfilePictureRules.Png or ProfilePictureRules.Webp ? file.ContentType : ProfilePictureRules.Jpeg;
        var image = await file.RequestImageFileAsync(format, ProfilePictureRules.UploadDimension, ProfilePictureRules.UploadDimension);
        return image.Size > ProfilePictureRules.MaxBytes ? null : (await ReadBytesAsync(image), image.ContentType);
    }

    private static async Task<byte[]> ReadBytesAsync(IBrowserFile file)
    {
        var bytes = new byte[file.Size];
        await using var stream = file.OpenReadStream(ProfilePictureRules.MaxBytes);
        await stream.ReadExactlyAsync(bytes);
        return bytes;
    }

    private async Task DeletePictureAsync()
    {
        message = null;
        busy = true;
        try
        {
            Apply(await Api.SendAsync<UserSettings>(HttpMethod.Delete, ApiRoutes.MyPicture));
        }
        finally
        {
            busy = false;
        }
    }

    private void Apply(ApiResult<UserSettings> result)
    {
        error = result.Error;
        if (result.IsSuccess)
        {
            Apply(result.Value);
        }
    }

    private void Apply(UserSettings updated)
    {
        settings = updated;
        CurrentUser.Update(updated);
    }
}
