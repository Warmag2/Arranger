@page "/"
@attribute [Authorize]
@inject ArrangerApi Api
@inject CurrentUser CurrentUser

<PageTitle>Arranger</PageTitle>

<a class="button button-submit" href="new">New</a>

<section>
    <h1>
        My arrangements
    </h1>

    @if (error != null)
    {
        <div class="error">@error</div>
    }
    else if (arrangements == null)
    {
        <p>Loading…</p>
    }
    else if (arrangements.Count == 0)
    {
        <p>None yet. Create one, or open a link someone shared with you.</p>
    }
    else
    {
        <div class="scroll">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Arrangement</th>
                        <th scope="col">Role</th>
                        <th scope="col" class="number">Members</th>
                        <th scope="col">Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var arrangement in arrangements)
                    {
                        <tr>
                            <td><a href="@arrangement.Id">@arrangement.Title</a></td>
                            <td>
                                <RoleBadge IsOwner="arrangement.IsOwner" IsAdmin="arrangement.IsAdmin" ShowMember="true" />
                            </td>
                            <td class="number">@arrangement.MemberCount</td>
                            <td>@DisplayFormat.Date(CurrentUser.ToLocalTime(arrangement.CreatedAt))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private List<ArrangementSummary>? arrangements;
    private string? error;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.GetSettingsAsync();
        var result = await Api.GetAsync<List<ArrangementSummary>>(ApiRoutes.Arrangements);
        arrangements = result.Value;
        error = result.Error;
    }
}
