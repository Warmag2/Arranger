@page "/"
@attribute [Authorize]
@inject ArrangerApi Api
@inject CurrentUser CurrentUser

<PageTitle>Arranger</PageTitle>

@if (error != null)
{
    <div class="error">@error</div>
}

<a class="button button-submit" href="new">New</a>

<section>
    <h2>
        My arrangements
    </h2>

    @if (arrangements == null)
    {
        <p>Loading…</p>
    }
    else if (arrangements.Count == 0)
    {
        <p>None yet. Create one, or open a link someone shared with you.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var arrangement in arrangements)
            {
                <li class="list-item" href="@arrangement.Id">
                    <span>
                        @arrangement.Title
                        @if (arrangement.IsOwner)
                        {
                            <span class="badge badge-owner">Owner</span>
                        }
                        else if (arrangement.IsAdmin)
                        {
                            <span class="badge badge-admin">Admin</span>
                        }
                    </span>
                    <p class="secondary">
                        @arrangement.MemberCount members · @CurrentUser.ToLocalTime(arrangement.CreatedAt).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                    </p>
                </li>
            }
        </ul>
    }
</section>

@code {
    private List<ArrangementSummary>? arrangements;
    private string? error;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.GetSettingsAsync();
        var result = await Api.GetAsync<List<ArrangementSummary>>("api/arrangements");
        arrangements = result.Value ?? [];
        error = result.Error;
    }
}
