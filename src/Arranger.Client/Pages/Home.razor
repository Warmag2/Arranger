@page "/"
@attribute [Authorize]
@inject ArrangerApi Api
@inject CurrentUser CurrentUser

<PageTitle>Arranger</PageTitle>

@if (error != null)
{
    <div class="error">@error</div>
}

<a class="button button-submit" href="new">New</a>

<section>
    <h2>
        My arrangements
    </h2>

    @if (arrangements == null)
    {
        <p>Loading…</p>
    }
    else if (arrangements.Count == 0)
    {
        <p>None yet. Create one, or open a link someone shared with you.</p>
    }
    else
    {
        <div class="scroll">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Arrangement</th>
                        <th scope="col">Role</th>
                        <th scope="col" class="number">Members</th>
                        <th scope="col">Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var arrangement in arrangements)
                    {
                        <tr>
                            <td><a href="@arrangement.Id">@arrangement.Title</a></td>
                            <td>
                                @if (arrangement.IsOwner)
                                {
                                    <span class="badge badge-owner">Owner</span>
                                }
                                else if (arrangement.IsAdmin)
                                {
                                    <span class="badge badge-admin">Admin</span>
                                }
                                else
                                {
                                    <span class="badge badge-member">Member</span>
                                }
                            </td>
                            <td class="number">@arrangement.MemberCount</td>
                            <td>@CurrentUser.ToLocalTime(arrangement.CreatedAt).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private List<ArrangementSummary>? arrangements;
    private string? error;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.GetSettingsAsync();
        var result = await Api.GetAsync<List<ArrangementSummary>>("api/arrangements");
        arrangements = result.Value ?? [];
        error = result.Error;
    }
}
