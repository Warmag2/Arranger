@page "/new"
@attribute [Authorize]
@inject ArrangerApi Api
@inject NavigationManager Navigation

<PageTitle>New arrangement · Arranger</PageTitle>

<h1>New arrangement</h1>

<form @onsubmit="CreateAsync">
    <div class="form">
        <label for="arrangement-title">Title</label>
        <input id="arrangement-title" maxlength="@ArrangementRules.TitleMaxLength" @bind="title" />
    </div>
    <div class="form">
        <label for="arrangement-description">Description (optional)</label>
        <textarea id="arrangement-description" rows="3" maxlength="@ArrangementRules.DescriptionMaxLength" @bind="description"></textarea>
    </div>
    <div class="form form-switch">
        <input type="checkbox" role="switch" id="schedule-enabled" @bind="isScheduleEnabled" />
        <label for="schedule-enabled">Schedule: find a time together</label>
    </div>
    <div class="form form-switch">
        <input type="checkbox" role="switch" id="expenses-enabled" @bind="isExpensesEnabled" />
        <label for="expenses-enabled">Expenses: share costs</label>
    </div>
    @if (error != null)
    {
        <div class="error">@error</div>
    }
    <div class="form form-submit">
        <button type="submit" class="button button-submit" disabled="@busy">Create</button>
        <a class="button" href="">Cancel</a>
    </div>
</form>

@code {
    private string title = string.Empty;
    private string description = string.Empty;
    private bool isScheduleEnabled = true;
    private bool isExpensesEnabled = true;
    private string? error;
    private bool busy;

    private async Task CreateAsync()
    {
        error = ArrangementRules.NormalizeDetails(title, description).Error;
        if (error != null)
        {
            return;
        }

        busy = true;
        ApiResult<ArrangementSnapshot> result;
        try
        {
            var request = new CreateArrangementRequest(title, description, !isScheduleEnabled, !isExpensesEnabled);
            result = await Api.SendAsync<ArrangementSnapshot>(HttpMethod.Post, ApiRoutes.Arrangements, request);
        }
        finally
        {
            busy = false;
        }

        if (result.IsSuccess)
        {
            Navigation.NavigateTo(result.Value.Id.ToString());
        }
        else
        {
            error = result.Error;
        }
    }
}
