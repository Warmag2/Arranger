@page "/new"
@attribute [Authorize]
@inject ArrangerApi Api
@inject NavigationManager Navigation

<PageTitle>New arrangement · Arranger</PageTitle>

<h1>New arrangement</h1>

<form class="new" @onsubmit="CreateAsync">
    <div class="mb-2">
        <input class="form-control" placeholder="Title" maxlength="@ArrangementRules.TitleMaxLength" @bind="title" />
    </div>
    <div class="mb-3">
        <textarea class="form-control" rows="3" placeholder="Description (optional)" maxlength="@ArrangementRules.DescriptionMaxLength" @bind="description"></textarea>
    </div>
    <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="schedule-enabled" @bind="isScheduleEnabled" />
        <label class="form-check-label" for="schedule-enabled">Schedule: find a time together</label>
    </div>
    <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" role="switch" id="expenses-enabled" @bind="isExpensesEnabled" />
        <label class="form-check-label" for="expenses-enabled">Expenses: share costs</label>
    </div>
    @if (error != null)
    {
        <div class="alert alert-danger">@error</div>
    }
    <button type="submit" class="btn btn-primary" disabled="@busy">Create</button>
    <a class="btn btn-outline-secondary" href="">Cancel</a>
</form>

@code {
    private string title = string.Empty;
    private string description = string.Empty;
    private bool isScheduleEnabled = true;
    private bool isExpensesEnabled = true;
    private string? error;
    private bool busy;

    private async Task CreateAsync()
    {
        error = ArrangementRules.ValidateDetails(ArrangementRules.NormalizeText(title), ArrangementRules.NormalizeText(description));
        if (error != null)
        {
            return;
        }

        busy = true;
        var request = new CreateArrangementRequest(title, description, isScheduleEnabled, isExpensesEnabled);
        var result = await Api.SendAsync<ArrangementSnapshot>(HttpMethod.Post, "api/arrangements", request);
        busy = false;
        if (result.IsSuccess)
        {
            Navigation.NavigateTo(result.Value.Id.ToString());
        }
        else
        {
            error = result.Error;
        }
    }
}
