@page "/new"
@attribute [Authorize]
@inject ArrangerApi Api
@inject NavigationManager Navigation

<PageTitle>New arrangement · Arranger</PageTitle>

<h1>New arrangement</h1>

<form @onsubmit="CreateAsync">
    <div class="form">
        <input class="input-text" placeholder="Title" maxlength="@ArrangementRules.TitleMaxLength" @bind="title" />
    </div>
    <div class="form">
        <textarea class="input-text" rows="3" placeholder="Description (optional)" maxlength="@ArrangementRules.DescriptionMaxLength" @bind="description"></textarea>
    </div>
    <div class="form form-switch">
        <input class="input-checkbox" type="checkbox" role="switch" id="schedule-enabled" @bind="isScheduleEnabled" />
        <label class="label-checkbox" for="schedule-enabled">Schedule: find a time together</label>
    </div>
    <div class="form form-switch">
        <input class="input-checkbox" type="checkbox" role="switch" id="expenses-enabled" @bind="isExpensesEnabled" />
        <label class="label-checkbox" for="expenses-enabled">Expenses: share costs</label>
    </div>
    @if (error != null)
    {
        <div class="error ">@error</div>
    }
    <div class="form form-submit">
        <button type="submit" class="button button-submit" disabled="@busy">Create</button>
        <a class="button button-cancel" href="">Cancel</a>
    </div>
</form>

@code {
    private string title = string.Empty;
    private string description = string.Empty;
    private bool isScheduleEnabled = true;
    private bool isExpensesEnabled = true;
    private string? error;
    private bool busy;

    private async Task CreateAsync()
    {
        error = ArrangementRules.ValidateDetails(ArrangementRules.NormalizeText(title), ArrangementRules.NormalizeText(description));
        if (error != null)
        {
            return;
        }

        busy = true;
        var request = new CreateArrangementRequest(title, description, isScheduleEnabled, isExpensesEnabled);
        var result = await Api.SendAsync<ArrangementSnapshot>(HttpMethod.Post, "api/arrangements", request);
        busy = false;
        if (result.IsSuccess)
        {
            Navigation.NavigateTo(result.Value.Id.ToString());
        }
        else
        {
            error = result.Error;
        }
    }
}
