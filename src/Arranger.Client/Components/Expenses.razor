@inject CurrentUser CurrentUser
@inject IJSRuntime JS

@{
    var me = Snapshot.FindMember(UserId);
    var isAdmin = me?.IsAdmin == true;
    var canEdit = me != null && !Snapshot.IsExpensesDisabled;
    var baseCurrency = Snapshot.BaseCurrency;
    var missing = ExpenseMath.MissingRates(Snapshot.Expenses, baseCurrency, Snapshot.ExchangeRates);
    var isInBase = missing.Count == 0;
    var balances = isInBase
        ? new Dictionary<string, IReadOnlyDictionary<Guid, decimal>> { [baseCurrency] = ExpenseMath.InBaseCurrency(Snapshot.Expenses, baseCurrency, Snapshot.ExchangeRates) }
        : ExpenseMath.Balances(Snapshot.Expenses).ToDictionary(b => b.Key, b => (IReadOnlyDictionary<Guid, decimal>)b.Value);
    var spent = isInBase
        ? new Dictionary<string, IReadOnlyDictionary<Guid, decimal>> { [baseCurrency] = ExpenseMath.InBaseCurrency(ExpenseMath.Spent(Snapshot.Expenses), baseCurrency, Snapshot.ExchangeRates) }
        : ExpenseMath.Spent(Snapshot.Expenses).ToDictionary(b => b.Key, b => (IReadOnlyDictionary<Guid, decimal>)b.Value);
    var payments = balances.SelectMany(b => ExpenseMath.SuggestPayments(b.Value, b.Key, Today())).ToList();
}

@if (Snapshot.IsExpensesDisabled)
{
    <div class="warning">The expenses are closed.</div>
}

@if (canEdit && isFormOpen)
{
    <form @onsubmit="SaveAsync">
        <div class="form">
            <label for="expense-description">Description</label>
            <input id="expense-description" maxlength="@ExpenseRules.DescriptionMaxLength" @bind="description" />
        </div>
        <div class="form">
            <label for="expense-amount">Amount</label>
            <input id="expense-amount" type="number" min="0" step="any" @bind="amount" />
        </div>
        <div class="form">
            <label>Currency</label>
            <FormComboBox TItem="string" Options="@CurrencyOptions()" SelectedOption="@currency" OnChanged="@(code => currency = code)" EnableErrorDisplay="true" />
        </div>
        <div class="form">
            <label for="expense-payer">Paid by</label>
            <select id="expense-payer" @bind="paidBy">
                @foreach (var member in Snapshot.Members)
                {
                    <option value="@member.UserId">@member.UserName</option>
                }
            </select>
        </div>
        <div class="form">
            <label for="expense-date">Date</label>
            <input id="expense-date" type="date" @bind="date" />
        </div>
        <div class="form">
            <label>@(isPayment ? "Paid to" : "Shared by")</label>
            <div class="form-submit">
                @foreach (var member in Snapshot.Members)
                {
                    var isIn = participants.Contains(member.UserId);
                    <button type="button" class="button" aria-pressed="@(isIn ? "true" : "false")" @onclick="() => Toggle(member.UserId)">@member.UserName</button>
                }
            </div>
        </div>
        <div class="form form-switch">
            <input id="expense-payment" type="checkbox" @bind="isPayment" />
            <label for="expense-payment">Payment to another member</label>
        </div>
        <div class="form-submit">
            <button type="submit" class="button button-submit" disabled="@Busy">@(editingId == null ? "Add" : "Save")</button>
            <button type="button" class="button" @onclick="() => isFormOpen = false">Cancel</button>
        </div>
        @if (formError != null)
        {
            <div class="warning">@formError</div>
        }
    </form>
}
else if (canEdit)
{
    <button class="button button-submit" @onclick="() => Open(null)">Add expense</button>
}

@if (Snapshot.Expenses.Count == 0)
{
    <p class="secondary">No expenses yet.</p>
}
else
{
    <div class="scroll">
        <table>
            <thead>
                <tr>
                    <th scope="col">Date</th>
                    <th scope="col" class="number">Amount</th>
                    <th scope="col">Paid by</th>
                    <th scope="col">For</th>
                    <th scope="col">Description</th>
                    @if (canEdit)
                    {
                        <th scope="col"></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var expense in Snapshot.Expenses)
                {
                    <tr class="@(expense.IsSettlementPayment ? "payment" : null)">
                        <td>@expense.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                        @* Paid in another currency: that amount, then its value in the base currency. *@
                        <td class="number">
                            @if (expense.Currency != baseCurrency)
                            {
                                <span class="secondary">
                                    @(expense.Currency == baseCurrency ? null : Money(expense.Amount, expense.Currency))
                                    &nbsp;
                                </span>
                            }
                            @(ExpenseMath.InBaseCurrency(expense.Amount, expense.Currency, baseCurrency, Snapshot.ExchangeRates) is { } inBase ? Money(inBase, baseCurrency) : $"? {baseCurrency}")
                        </td>
                        <td>@Name(expense.PaidByUserId)</td>
                        <td>
                            @if (expense.ParticipantUserIds.Count == Snapshot.Members.Count && !expense.IsSettlementPayment)
                            {
                                <span>Everyone</span>
                            }
                            else
                            {
                                @foreach (var id in expense.ParticipantUserIds)
                                {
                                    <span class="badge">@Name(id)</span>
                                }
                            }
                        </td>
                        <td>@expense.Description</td>
                        @if (canEdit)
                        {
                            <td class="number">
                                @if (isAdmin || expense.PaidByUserId == UserId)
                                {
                                    <button class="button" disabled="@Busy" title="Edit" @onclick="() => Open(expense)">✎&#xFE0E;</button>
                                    <button class="button button-delete" disabled="@Busy" title="Delete" @onclick="() => DeleteAsync(expense)">×</button>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Snapshot.Expenses.Count > 0)
{
    <h2>Balances@(isInBase ? $" in {baseCurrency}" : null)</h2>
    @if (!isInBase)
    {
        <div class="warning">Set the exchange rate of @string.Join(", ", missing) in <a href="@Snapshot.Id/settings">⚙ settings</a> to see the balances in @baseCurrency.</div>
    }
    @foreach (var (code, users) in balances)
    {
        <div class="scroll">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Member</th>
                        <th scope="col" class="number" title="What they paid, payments included">Spent</th>
                        <th scope="col" class="number" title="Their shares of the expenses, payments to them included">Received</th>
                        <th scope="col" class="number">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Snapshot.Members.Where(m => users.ContainsKey(m.UserId)))
                    {
                        // Received is derived so the rounded columns always add up.
                        var balance = users[member.UserId];
                        var paid = spent[code].GetValueOrDefault(member.UserId);
                        <tr>
                            <td>@member.UserName</td>
                            <td class="number">@Money(paid, code)</td>
                            <td class="number">@Money(paid - balance, code)</td>
                            <td class="number @BalanceClass(balance)">@Money(balance, code)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h2>Suggested payments</h2>
    @if (payments.Count == 0)
    {
        <p class="secondary">Everyone is settled.</p>
    }
    else
    {
        <div class="scroll">
            <table>
                <thead>
                    <tr>
                        <th scope="col">From</th>
                        <th scope="col">To</th>
                        <th scope="col" class="number">Amount</th>
                        @if (canEdit)
                        {
                            <th scope="col"></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in payments)
                    {
                        <tr>
                            <td>@Name(payment.PaidByUserId)</td>
                            <td>@Name(payment.ParticipantUserIds[0])</td>
                            <td class="number">@Money(payment.Amount, payment.Currency)</td>
                            @if (canEdit)
                            {
                                <td class="number">
                                    <button class="button button-submit" disabled="@Busy" title="Add this payment to the expenses" @onclick="() => RecordAsync(payment)">Record payment</button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private bool isFormOpen;
    private long? editingId;
    private string description = string.Empty;
    private decimal amount;
    private string currency = Currencies.Default;
    private Guid paidBy;
    private DateOnly date;
    private bool isPayment;
    private HashSet<Guid> participants = [];
    private string? formError;

    /// <summary>
    /// The arrangement.
    /// </summary>
    [Parameter, EditorRequired]
    public ArrangementSnapshot Snapshot { get; set; } = null!;

    /// <summary>
    /// The viewer's user ID.
    /// </summary>
    [Parameter, EditorRequired]
    public Guid UserId { get; set; }

    /// <summary>
    /// Whether a command is in progress.
    /// </summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>
    /// Runs a command: the method, the path under the arrangement, and the body. Returns whether it succeeded.
    /// </summary>
    [Parameter, EditorRequired]
    public Func<HttpMethod, string, object?, Task<bool>> Run { get; set; } = null!;

    private static string Money(decimal value, string code)
    {
        return $"{value.ToString("N" + Currencies.Decimals(code), CultureInfo.CurrentCulture)} {code}";
    }

    private static string? BalanceClass(decimal balance)
    {
        return Math.Sign(balance) switch
        {
            < 0 => "negative",
            > 0 => "positive",
            _ => null,
        };
    }

    private DateOnly Today()
    {
        return DateOnly.FromDateTime(CurrentUser.ToLocalTime(DateTime.UtcNow));
    }

    private string Name(Guid userId)
    {
        return Snapshot.FindMember(userId)?.UserName ?? "?";
    }

    private SortedDictionary<string, string> CurrencyOptions()
    {
        // An edited expense or a suggested payment may use a currency that is not listed; keep the current one selectable.
        return Currencies.Options(Snapshot.AvailableCurrencies().Append(currency).Distinct());
    }

    private void Open(ExpenseSnapshot? expense)
    {
        // A new expense: the currency of the last one added if still available, paid by me, shared by everyone.
        var available = Snapshot.AvailableCurrencies();
        var last = Snapshot.Expenses.Where(e => available.Contains(e.Currency)).MaxBy(e => e.Id);
        editingId = expense?.Id;
        description = expense?.Description ?? string.Empty;
        amount = expense?.Amount ?? 0;
        currency = expense?.Currency ?? last?.Currency ?? Snapshot.BaseCurrency;
        paidBy = expense?.PaidByUserId ?? UserId;
        date = expense?.Date ?? Today();
        isPayment = expense?.IsSettlementPayment ?? false;
        participants = (expense?.ParticipantUserIds ?? Snapshot.Members.Select(m => m.UserId)).ToHashSet();
        formError = null;
        isFormOpen = true;
    }

    private void Toggle(Guid userId)
    {
        if (!participants.Remove(userId))
        {
            participants.Add(userId);
        }
    }

    private async Task SaveAsync()
    {
        var ids = Snapshot.Members.Select(m => m.UserId).Where(participants.Contains).ToList();
        var request = new ExpenseRequest(description.Trim(), amount, currency, paidBy, ids, date, isPayment);
        formError = ExpenseRules.Validate(request);
        if (formError == null && await Run(editingId == null ? HttpMethod.Post : HttpMethod.Put, editingId == null ? "expenses" : $"expenses/{editingId}", request))
        {
            isFormOpen = false;
        }
    }

    private async Task DeleteAsync(ExpenseSnapshot expense)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Delete \"{expense.Description}\"?"))
        {
            await Run(HttpMethod.Delete, $"expenses/{expense.Id}", null);
        }
    }

    private Task<bool> RecordAsync(ExpenseRequest payment)
    {
        return Run(HttpMethod.Post, "expenses", payment with { Description = $"Payment to {Name(payment.ParticipantUserIds[0])}" });
    }
}
