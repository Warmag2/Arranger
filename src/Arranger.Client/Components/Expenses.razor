@inherits ArrangementComponentBase
@inject CurrentUser CurrentUser
@inject IJSRuntime JS

@{
    var canEdit = Me != null && !Snapshot.IsExpensesDisabled;
    var baseCurrency = Snapshot.BaseCurrency;
    var isInBase = missing.Count == 0;
    var payments = balances.SelectMany(b => ExpenseMath.SuggestPayments(b.Value, b.Key, CurrentUser.Today())).ToList();
}

@if (Snapshot.IsExpensesDisabled)
{
    <div class="warning">The expenses are closed.</div>
}

@if (canEdit && isFormOpen)
{
    <form @onsubmit="SaveAsync">
        <div class="form">
            <label for="expense-description">Description</label>
            <input id="expense-description" maxlength="@ExpenseRules.DescriptionMaxLength" @bind="description" />
        </div>
        <div class="form">
            <label for="expense-amount">Amount</label>
            <input id="expense-amount" type="number" min="0" step="any" @bind="amount" />
        </div>
        <div class="form">
            <label for="expense-currency">Currency</label>
            <FormComboBox TItem="string" Id="expense-currency" Options="@CurrencyOptions()" SelectedOption="@currency" OnChanged="@(code => currency = code)" EnableErrorDisplay="true" />
        </div>
        <div class="form">
            <label for="expense-payer">Paid by</label>
            <select id="expense-payer" @bind="paidBy">
                @foreach (var member in Snapshot.Members)
                {
                    <option value="@member.UserId">@member.UserName</option>
                }
            </select>
        </div>
        <div class="form">
            <label for="expense-date">Date</label>
            <input id="expense-date" type="date" @bind="date" />
        </div>
        <div class="form">
            <span id="expense-participants">@(isPayment ? "Paid to" : "Shared by")</span>
            @{
                var allSelected = participants.Count == Snapshot.Members.Count;
            }
            <div class="form-submit">
                <button type="button" class="button" @onclick="ToggleAll">@(allSelected ? "None" : "All")</button>
            </div>
            <div class="form-submit" role="group" aria-labelledby="expense-participants">
                @foreach (var member in Snapshot.Members)
                {
                    var isIn = participants.Contains(member.UserId);
                    <button type="button" class="button" aria-pressed="@(isIn ? "true" : "false")" @onclick="() => Toggle(member.UserId)">@member.UserName</button>
                }
            </div>
        </div>
        <div class="form form-switch">
            <input id="expense-payment" type="checkbox" @bind="isPayment" />
            <label for="expense-payment">Payment is part of final settlement (visual distinction)</label>
        </div>
        <div class="form-submit">
            <button type="submit" class="button button-submit" disabled="@Busy">@(editingId == null ? "Add" : "Save")</button>
            <button type="button" class="button" @onclick="() => isFormOpen = false">Cancel</button>
        </div>
        @if (formError != null)
        {
            <div class="warning">@formError</div>
        }
    </form>
}
else if (canEdit)
{
    <button class="button button-submit" @onclick="() => Open(null)">Add expense</button>
}

@if (Snapshot.Expenses.Count == 0)
{
    <p class="secondary">No expenses yet.</p>
}
else
{
    <div class="scroll">
        <table>
            <thead>
                <tr>
                    <th scope="col">Date</th>
                    <th scope="col" class="number">Amount</th>
                    <th scope="col">Paid by</th>
                    <th scope="col">For</th>
                    <th scope="col">Description</th>
                    @if (canEdit)
                    {
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var expense in Snapshot.Expenses)
                {
                    <tr class="@(expense.IsSettlementPayment ? "payment" : null)">
                        <td>@DisplayFormat.Date(expense.Date)</td>
                        @* Paid in another currency: that amount, then its value in the base currency. *@
                        <td class="number">
                            @if (expense.Currency != baseCurrency)
                            {
                                <span class="secondary">
                                    @DisplayFormat.Money(expense.Amount, expense.Currency)
                                    &nbsp;
                                </span>
                            }
                            @(ExpenseMath.InBaseCurrency(expense.Amount, expense.Currency, baseCurrency, Snapshot.ExchangeRates) is { } inBase ? DisplayFormat.Money(inBase, baseCurrency) : $"? {baseCurrency}")
                        </td>
                        <td>@Name(expense.PaidByUserId)</td>
                        <td>
                            @if (expense.ParticipantUserIds.Count == Snapshot.Members.Count && !expense.IsSettlementPayment)
                            {
                                <span>Everyone</span>
                            }
                            else
                            {
                                @foreach (var id in expense.ParticipantUserIds)
                                {
                                    <span class="badge">@Name(id)</span>
                                }
                            }
                        </td>
                        <td>@expense.Description</td>
                        @if (canEdit)
                        {
                            <td class="number">
                                @if (IsAdmin || expense.PaidByUserId == UserId)
                                {
                                    <button class="button" disabled="@Busy" title="Edit" aria-label="Edit" @onclick="() => Open(expense)">✎&#xFE0E;</button>
                                    <button class="button button-delete" disabled="@Busy" title="Delete" aria-label="Delete" @onclick="() => DeleteAsync(expense)">×</button>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Snapshot.Expenses.Count > 0)
{
    <h2>Balances@(isInBase ? $" in {baseCurrency}" : null)</h2>
    @if (!isInBase)
    {
        <div class="warning">Set the exchange rate of @string.Join(", ", missing) in <a href="@Snapshot.Id/settings">⚙ settings</a> to see the balances in @baseCurrency.</div>
    }
    @foreach (var (code, users) in balances)
    {
        <div class="scroll">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Member</th>
                        <th scope="col" class="number" title="What they paid, payments included">Spent</th>
                        <th scope="col" class="number" title="Their shares of the expenses, payments to them included">Received</th>
                        <th scope="col" class="number">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Snapshot.Members.Where(m => users.ContainsKey(m.UserId)))
                    {
                        // Spent and received are counted independently; their difference is the balance (double bookkeeping).
                        var balance = users[member.UserId];
                        var paid = spent[code].GetValueOrDefault(member.UserId);
                        var gained = received[code].GetValueOrDefault(member.UserId);
                        <tr>
                            <td>@member.UserName</td>
                            <td class="number">@DisplayFormat.Money(paid, code)</td>
                            <td class="number">@DisplayFormat.Money(gained, code)</td>
                            <td class="number @BalanceClass(balance)">@DisplayFormat.Money(balance, code)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h2>Suggested payments</h2>
    @if (payments.Count == 0)
    {
        <p class="secondary">Everyone is settled.</p>
    }
    else
    {
        <div class="scroll">
            <table>
                <thead>
                    <tr>
                        <th scope="col">From</th>
                        <th scope="col">To</th>
                        <th scope="col" class="number">Amount</th>
                        @if (canEdit)
                        {
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in payments)
                    {
                        <tr>
                            <td>@Name(payment.PaidByUserId)</td>
                            <td>@Name(payment.ParticipantUserIds[0])</td>
                            <td class="number">@DisplayFormat.Money(payment.Amount, payment.Currency)</td>
                            @if (canEdit)
                            {
                                <td class="number">
                                    <button class="button button-submit" disabled="@Busy" title="Add this payment to the expenses" @onclick="() => RecordAsync(payment)">Record payment</button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private bool isFormOpen;
    private long? editingId;
    private string description = string.Empty;
    private decimal amount;
    private string currency = Currencies.Default;
    private Guid paidBy;
    private DateOnly date;
    private bool isPayment;
    private HashSet<Guid> participants = [];
    private string? formError;

    // The totals of totalsOf. Recalculated only when a new snapshot arrives, not on every click in the form.
    private ArrangementSnapshot? totalsOf;
    private IReadOnlyList<string> missing = [];
    private IReadOnlyDictionary<string, IReadOnlyDictionary<Guid, decimal>> balances = new Dictionary<string, IReadOnlyDictionary<Guid, decimal>>();
    private IReadOnlyDictionary<string, IReadOnlyDictionary<Guid, decimal>> spent = new Dictionary<string, IReadOnlyDictionary<Guid, decimal>>();
    private IReadOnlyDictionary<string, IReadOnlyDictionary<Guid, decimal>> received = new Dictionary<string, IReadOnlyDictionary<Guid, decimal>>();

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(totalsOf, Snapshot))
        {
            return;
        }

        totalsOf = Snapshot;
        missing = ExpenseMath.MissingRates(Snapshot.Expenses, Snapshot.BaseCurrency, Snapshot.ExchangeRates);
        balances = Display(ExpenseMath.Balances(Snapshot.Expenses));
        spent = Display(ExpenseMath.Spent(Snapshot.Expenses));
        received = Display(ExpenseMath.Received(Snapshot.Expenses));
    }

    private static string? BalanceClass(decimal balance)
    {
        return Math.Sign(balance) switch
        {
            < 0 => "negative",
            > 0 => "positive",
            _ => null,
        };
    }

    private string Name(Guid userId)
    {
        return Snapshot.FindMember(userId)?.UserName ?? "?";
    }

    private SortedDictionary<string, string> CurrencyOptions()
    {
        // An edited expense or a suggested payment may use a currency that is not listed; keep the current one selectable.
        return Currencies.Options(Snapshot.AvailableCurrencies().Append(currency).Distinct());
    }

    private IReadOnlyDictionary<string, IReadOnlyDictionary<Guid, decimal>> Display(IReadOnlyDictionary<string, Dictionary<Guid, decimal>> sums)
    {
        // All in the base currency when every rate is known, otherwise per currency.
        return missing.Count == 0
            ? new Dictionary<string, IReadOnlyDictionary<Guid, decimal>> { [Snapshot.BaseCurrency] = ExpenseMath.InBaseCurrency(sums, Snapshot.BaseCurrency, Snapshot.ExchangeRates) }
            : sums.ToDictionary(b => b.Key, b => (IReadOnlyDictionary<Guid, decimal>)b.Value);
    }

    private void Open(ExpenseSnapshot? expense)
    {
        // A new expense: the currency of the last one added if still available, paid by me, benefitted only by me by default.
        var available = Snapshot.AvailableCurrencies();
        var last = Snapshot.Expenses.Where(e => available.Contains(e.Currency)).MaxBy(e => e.Id);
        editingId = expense?.Id;
        description = expense?.Description ?? string.Empty;
        amount = expense?.Amount ?? 0;
        currency = expense?.Currency ?? last?.Currency ?? Snapshot.BaseCurrency;
        paidBy = expense?.PaidByUserId ?? UserId;
        date = expense?.Date ?? CurrentUser.Today();
        isPayment = expense?.IsSettlementPayment ?? false;
        participants = (expense?.ParticipantUserIds ?? new[] { UserId }).ToHashSet();
        formError = null;
        isFormOpen = true;
    }

    private void Toggle(Guid userId)
    {
        if (!participants.Remove(userId))
        {
            participants.Add(userId);
        }
    }

    private void ToggleAll()
    {
        if (participants.Count == Snapshot.Members.Count)
        {
            participants.Clear();
        }
        else
        {
            participants = Snapshot.Members.Select(m => m.UserId).ToHashSet();
        }
    }

    private async Task SaveAsync()
    {
        var ids = Snapshot.Members.Select(m => m.UserId).Where(participants.Contains).ToList();
        var request = new ExpenseRequest(description.Trim(), amount, currency, paidBy, ids, date, isPayment);
        formError = ExpenseRules.Validate(request);
        if (formError == null && await Run(editingId == null ? HttpMethod.Post : HttpMethod.Put, editingId == null ? "expenses" : $"expenses/{editingId}", request))
        {
            isFormOpen = false;
        }
    }

    private async Task DeleteAsync(ExpenseSnapshot expense)
    {
        if (await JS.ConfirmAsync($"Delete \"{expense.Description}\"?"))
        {
            await Run(HttpMethod.Delete, $"expenses/{expense.Id}", null);
        }
    }

    private Task<bool> RecordAsync(ExpenseRequest payment)
    {
        return Run(HttpMethod.Post, "expenses", payment with { Description = $"Payment to {Name(payment.ParticipantUserIds[0])}" });
    }
}
