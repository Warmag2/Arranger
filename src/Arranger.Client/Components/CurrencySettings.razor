@inject IJSRuntime JS

@{
    var me = Snapshot.FindMember(UserId);
    var isAdmin = me?.IsAdmin == true;
    var canManageCurrencies = isAdmin && !Snapshot.IsExpensesDisabled;
    var baseCurrency = Snapshot.BaseCurrency;
    var shown = Snapshot.Expenses.Select(e => e.Currency)
        .Concat(Snapshot.ExchangeRates.Keys)
        .Where(c => c != baseCurrency)
        .Distinct()
        .Order(StringComparer.Ordinal)
        .ToList();
}

<section @key="attempts">
    <h2>
        Currencies
    </h2>
    <div class="form form-select">
        <label class="label-text">Base currency</label>
        <FormComboBox TItem="string" Options="@Currencies.Options()" SelectedOption="@baseCurrency" OnChanged="SetBaseCurrencyAsync" />
    </div>

    @foreach (var currency in shown)
    {
        var rate = Snapshot.ExchangeRates.GetValueOrDefault(currency);
        var isUsed = Snapshot.Expenses.Any(e => e.Currency == currency);
        <div class="form form-group">
            <label class="label-text" for="rate-@currency">1 @baseCurrency =</label>
            <input id="rate-@currency" class="form-number" type="number" min="0" step="any" disabled="@(!canManageCurrencies || Busy)"
                   value="@Number(rate?.Rate)" @onchange="e => SetRateAsync(currency, Parse(e.Value), rate?.LossPercent ?? 0)" />
            <span class="form-group-text">@currency</span>
            <label class="label-text" for="loss-@currency" title="Average loss on converting to @currency">loss</label>
            <input id="loss-@currency" class="form-number" type="number" min="0" max="@ExpenseRules.MaxLossPercent" step="any"
                   disabled="@(!canManageCurrencies || Busy)" value="@Number(rate?.LossPercent ?? 0)"
                   @onchange="e => SetRateAsync(currency, rate?.Rate, Parse(e.Value) ?? 0)" />
            <span class="form-group-text">%</span>
            <button class="button button-delete" type="button" disabled="@(!canManageCurrencies || Busy || isUsed || rate == null)"
                    title="@(isUsed ? "Used by expenses" : "Remove the currency")" aria-label="Remove @currency"
                    @onclick="() => RemoveAsync(currency)">×</button>
        </div>
    }

    @if (canManageCurrencies)
    {
        <div class="form form-select">
            <label class="label-text">Add a currency</label>
            <FormComboBox TItem="string" Options="@AddableCurrencyOptions(shown, baseCurrency)" OnChanged="AddAsync" />
        </div>
        @if (shown.Count > 0)
        {
            <div class="form">
                <button class="button" type="button" disabled="@Busy" @onclick="RefreshRatesAsync">Refresh rates</button>
            </div>
        }
    }

    <p class="secondary">
        Expenses can be recorded in the base currency or in any of the currencies added here. Balances are shown in the base
        currency once the currency used has a conversion rate. Changing the base currency, clears the rates and a newly added
        currency starts at the latest fetched market rate. Rates can be refreshed to match the latest daily rate.
        A currency can be removed while no expense uses it. The loss is the average conversion loss for a person when paying
        in a foreign currency (may be 0).
        <br />
        Admin only.
    </p>
</section>

@code {
    private int attempts;

    /// <summary>
    /// The arrangement.
    /// </summary>
    [Parameter, EditorRequired]
    public ArrangementSnapshot Snapshot { get; set; } = null!;

    /// <summary>
    /// The viewer's user ID.
    /// </summary>
    [Parameter, EditorRequired]
    public Guid UserId { get; set; }

    /// <summary>
    /// Whether a command is in progress.
    /// </summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>
    /// Runs a command: the method, the path under the arrangement, and the body. Returns whether it succeeded.
    /// </summary>
    [Parameter, EditorRequired]
    public Func<HttpMethod, string?, object?, Task<bool>> Run { get; set; } = null!;

    private static string Number(decimal? value)
    {
        return value?.ToString("0.########", CultureInfo.InvariantCulture) ?? string.Empty;
    }

    private static decimal? Parse(object? value)
    {
        // A number input reports an invariant number, or nothing when emptied.
        return value is string text && !string.IsNullOrWhiteSpace(text) ? decimal.Parse(text, NumberStyles.Float, CultureInfo.InvariantCulture) : null;
    }

    private static SortedDictionary<string, string> AddableCurrencyOptions(List<string> shown, string baseCurrency)
    {
        return Currencies.Options(Currencies.All
            .Where(c => c.Code != baseCurrency && !shown.Contains(c.Code))
            .Select(c => c.Code));
    }

    private async Task AddAsync(string code)
    {
        if (code.Length > 0)
        {
            await Run(HttpMethod.Put, $"rates/{code}", new SetExchangeRateRequest(null));
        }

        attempts++;
    }

    private async Task RemoveAsync(string code)
    {
        await Run(HttpMethod.Delete, $"rates/{code}", null);
        attempts++;
    }

    private async Task RefreshRatesAsync()
    {
        await Run(HttpMethod.Post, "rates/refresh", null);
        attempts++;
    }

    private async Task SetRateAsync(string code, decimal? rate, decimal lossPercent)
    {
        await Run(HttpMethod.Put, $"rates/{code}", new SetExchangeRateRequest(rate, lossPercent));
        attempts++;
    }

    private async Task SetBaseCurrencyAsync(string currency)
    {
        if (currency == Snapshot.BaseCurrency)
        {
            return;
        }

        if (Snapshot.ExchangeRates.Count == 0 || await JS.InvokeAsync<bool>("confirm", $"Change the base currency to {currency}? The exchange rates are cleared, but the currencies stay."))
        {
            await Run(HttpMethod.Put, "base-currency", new SetBaseCurrencyRequest(currency));
        }

        attempts++;
    }
}
