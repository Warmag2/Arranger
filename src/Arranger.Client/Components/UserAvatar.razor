@if (PictureVersion is { } version)
{
    <img class="avatar" src="@ApiRoutes.UserPicture(UserId, version)" width="@Size" height="@Size" alt="" loading="lazy" />
}
else
{
    @* No picture: the initial on a colour derived from the user ID, drawn here so that it needs no request. *@
    <svg class="avatar" width="@Size" height="@Size" viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" fill="hsl(@Hue(), 45%, 45%)" />
        <text x="32" y="32" dy=".35em" text-anchor="middle" font-family="sans-serif" font-size="32" fill="#fff">@Initial()</text>
    </svg>
}

@code {
    /// <summary>
    /// The version of the user's picture, or <b>null</b> when there is none. A new version means a new address, so a
    /// cached picture is never shown after a change.
    /// </summary>
    [Parameter]
    public uint? PictureVersion { get; set; }

    /// <summary>
    /// The width and height in pixels.
    /// </summary>
    [Parameter]
    public int Size { get; set; } = 32;

    /// <summary>
    /// The public ID of the user whose picture to show.
    /// </summary>
    [Parameter, EditorRequired]
    public Guid UserId { get; set; }

    /// <summary>
    /// The user's username, whose first letter is shown when there is no picture.
    /// </summary>
    [Parameter, EditorRequired]
    public string UserName { get; set; } = string.Empty;

    private int Hue()
    {
        return UserId.ToByteArray()[0] * 360 / 256;
    }

    private string Initial()
    {
        return UserName.Length == 0 ? "?" : UserName[..1].ToUpperInvariant();
    }
}
