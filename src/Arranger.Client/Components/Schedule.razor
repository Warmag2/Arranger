@inject CurrentUser CurrentUser
@inject IJSRuntime JS

@{
    var me = Snapshot.FindMember(UserId);
    var isAdmin = me?.IsAdmin == true;
    var canEdit = me != null && !Snapshot.IsScheduleDisabled;
    var canAddTime = canEdit && (isAdmin || Snapshot.AllowNewTimes);
    var final = Snapshot.TimeOptions.FirstOrDefault(o => o.Id == Snapshot.FinalTimeOptionId);
}

@if (Snapshot.IsScheduleDisabled)
{
    <div class="@(final == null ? "warning" : "success")">
        @if (final == null)
        {
            <span>The schedule is closed.</span>
        }
        else
        {
            var (day, time) = ScheduleFormat.Describe(final, CurrentUser.TimeZone);
            <span>The time is <strong>@day @time</strong>.</span>
        }
        @if (isAdmin)
        {
            <button class="button button-submit" disabled="@Busy" @onclick="ReopenAsync">Reopen</button>
        }
    </div>
}
else if (final != null || isAdmin)
{
    @if (isAdmin)
    {
        <div>
            <button class="button button-submit" disabled="@Busy" title="Stop changes and confirm the picked time" @onclick="CloseAsync">Close schedule</button>
        </div>
    }
    <div>
        @if (final != null)
        {
            var (day, time) = ScheduleFormat.Describe(final, CurrentUser.TimeZone);
            <p>Picked: <strong>@day @time</strong></p>
        }
        else
        {
            <p>No date selction yet.</p>
        }
    </div>
}

@if (Snapshot.TimeOptions.Count == 0)
{
    <p class="secondary">No times proposed yet.</p>
}
else
{
    <div class="schedule">
        <table>
            <thead>
                <tr>
                    <th scope="col"></th>
                    @foreach (var option in Snapshot.TimeOptions)
                    {
                        var (day, time) = ScheduleFormat.Describe(option, CurrentUser.TimeZone);
                        <th scope="col" class="@FinalClass(option)">
                            <div>@day</div>
                            <small>@time</small>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var member in Snapshot.Members)
                {
                    var isMine = member.UserId == UserId;
                    <tr>
                        <th scope="row">
                            <UserAvatar UserId="member.UserId" Size="24" />
                            @member.UserName
                        </th>
                        @foreach (var option in Snapshot.TimeOptions)
                        {
                            var answer = option.FindAnswer(member.UserId);
                            <td class="@CellClass(answer) @FinalClass(option)">
                                @if (isMine && canEdit)
                                {
                                    <button class="answer" disabled="@Busy" title="Tap to change your answer" @onclick="() => VoteAsync(option, answer)">
                                        @(answer == null ? "·" : ScheduleFormat.Symbol(answer))
                                    </button>
                                }
                                else
                                {
                                    @ScheduleFormat.Symbol(answer)
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th scope="row">Yes <small>(maybe)</small></th>
                    @foreach (var option in Snapshot.TimeOptions)
                    {
                        var maybe = option.Count(VoteAnswer.Maybe);
                        <td class="@FinalClass(option)">
                            <strong>@option.Count(VoteAnswer.Yes)</strong>
                            @if (maybe > 0)
                            {
                                <span> (@maybe)</span>
                            }
                        </td>
                    }
                </tr>
                @if (canAddTime)
                {
                    <tr>
                        <td></td>
                        @foreach (var option in Snapshot.TimeOptions)
                        {
                            <td>
                                @if (isAdmin)
                                {
                                    var isPicked = option.Id == Snapshot.FinalTimeOptionId;
                                    <button class="button" aria-pressed="@(isPicked ? "true" : "false")" disabled="@Busy" title="@(isPicked ? "Clear the pick" : "Pick this time")"
                                            @onclick="() => PickAsync(isPicked ? null : option.Id)">Pick</button>
                                }
                                <button class="button button-delete" disabled="@Busy" title="Remove this time" @onclick="() => RemoveAsync(option)">×</button>
                            </td>
                        }
                    </tr>
                }
            </tfoot>
        </table>
    </div>
}

@if (canAddTime && !adding)
{
    <button class="button button-submit" @onclick="() => adding = true">Add time</button>
}
else if (canAddTime)
{
    <form @onsubmit="AddAsync">
        <div class="form">
            <label for="option-date">Start date</label>
            <input id="option-date" type="date" @bind="date" />
        </div>
        <div class="form">
            <label for="option-end-date">End date (optional)</label>
            <input id="option-end-date" type="date" @bind="endDate" />
        </div>
        @if (!isWholeDay)
        {
            <div class="form">
                <label for="option-start">Start</label>
                <input id="option-start" type="time" @bind="start" />
            </div>
            <div class="form">
                <label for="option-end">End (optional)</label>
                <input id="option-end" type="time" @bind="end" />
            </div>
        }
        <div class="form form-switch">
            <input id="option-whole-day" type="checkbox" @bind="isWholeDay" />
            <label for="option-whole-day">All day</label>
        </div>
        <div class="form form-submit">
            <button type="submit" class="button button-submit" disabled="@Busy">Add</button>
            <button type="button" class="button" @onclick="() => adding = false">Done</button>
        </div>
    </form>
    @if (formError != null)
    {
        <div class="warning">@formError</div>
    }
}

@code {
    private DateOnly date;
    private DateOnly? endDate;
    private TimeOnly start = new(18, 0);
    private TimeOnly? end;
    private bool isWholeDay;
    private bool adding;
    private string? formError;

    /// <summary>
    /// The arrangement.
    /// </summary>
    [Parameter, EditorRequired]
    public ArrangementSnapshot Snapshot { get; set; } = null!;

    /// <summary>
    /// The viewer's user ID.
    /// </summary>
    [Parameter, EditorRequired]
    public Guid UserId { get; set; }

    /// <summary>
    /// Whether a command is in progress.
    /// </summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>
    /// Runs a command: the method, the path under the arrangement, and the body.
    /// </summary>
    [Parameter, EditorRequired]
    public Func<HttpMethod, string, object?, Task> Run { get; set; } = null!;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        date = DateOnly.FromDateTime(CurrentUser.ToLocalTime(DateTime.UtcNow));
    }

    private static string? CellClass(VoteAnswer? answer)
    {
        return answer switch
        {
            VoteAnswer.Yes => "yes",
            VoteAnswer.Maybe => "maybe",
            VoteAnswer.No => "no",
            _ => null,
        };
    }

    private string? FinalClass(TimeOptionSnapshot option)
    {
        return option.Id == Snapshot.FinalTimeOptionId ? "final" : null;
    }

    private Task VoteAsync(TimeOptionSnapshot option, VoteAnswer? answer)
    {
        return Run(HttpMethod.Put, $"time-options/{option.Id}/vote", new SetVoteRequest(ScheduleFormat.Next(answer)));
    }

    private Task PickAsync(long? timeOptionId)
    {
        return Run(HttpMethod.Put, "pick", new PickTimeRequest(timeOptionId));
    }

    private async Task CloseAsync()
    {
        if (Snapshot.FinalTimeOptionId != null || await JS.InvokeAsync<bool>("confirm", "Close the schedule without picking a time?"))
        {
            await SetScheduleEnabledAsync(false);
        }
    }

    private Task ReopenAsync()
    {
        return SetScheduleEnabledAsync(true);
    }

    private Task SetScheduleEnabledAsync(bool isEnabled)
    {
        return Run(HttpMethod.Put, "tabs", new SetTabsRequest(isEnabled, !Snapshot.IsExpensesDisabled));
    }

    private async Task RemoveAsync(TimeOptionSnapshot option)
    {
        if (option.Votes.Count == 0 || await JS.InvokeAsync<bool>("confirm", "Remove this time and its answers?"))
        {
            await Run(HttpMethod.Delete, $"time-options/{option.Id}", null);
        }
    }

    private async Task AddAsync()
    {
        var request = isWholeDay ? CreateWholeDayRequest() : CreateTimedRequest();
        formError = request == null
            ? "That time does not exist in your time zone because of a daylight saving change."
            : ArrangementRules.ValidateTimeOption(request.DateBegin, request.DateEnd, request.IsWholeDay);
        if (formError == null)
        {
            await Run(HttpMethod.Post, "time-options", request);
        }
    }

    private AddTimeOptionRequest CreateWholeDayRequest()
    {
        var begin = date.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc);
        DateTime? endUtc = endDate is { } value && value > date ? value.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc) : null;
        return new AddTimeOptionRequest(begin, endUtc, true);
    }

    private AddTimeOptionRequest? CreateTimedRequest()
    {
        var begin = CurrentUser.ToUtc(date, start);
        DateTime? endUtc = null;
        if (end is { } endTime)
        {
            // When no end date is given, the end falls on the start date.
            endUtc = CurrentUser.ToUtc(endDate ?? date, endTime);
        }

        return begin == null || (end != null && endUtc == null) ? null : new AddTimeOptionRequest(begin.Value, endUtc, false);
    }
}
