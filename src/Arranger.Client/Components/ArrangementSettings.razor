@inject ArrangerApi Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

@{
    var me = Snapshot.FindMember(UserId);
    var isOwner = me != null && Snapshot.OwnerUserId == UserId;
    var isAdmin = me?.IsAdmin == true;
    var link = Navigation.ToAbsoluteUri(Snapshot.Id.ToString()).ToString();
}

<section>
    <h2>
        Link
    </h2>
    <div class="form form-submit">
        <input class="input-button" readonly value="@link" aria-label="Link to this arrangement" />
        <button class="button button-submit" @onclick="() => CopyAsync(link)">@(copied ? "Copied" : "Copy")</button>
    </div>
    @if (copyFailed)
    {
        <div class="form">Copying is not available here. Copy the link from the box instead.</div>
    }
</section>

<section>
    <h2>
        Members (@Snapshot.Members.Count)
    </h2>
    <div class="scroll">
        <table>
            <thead>
                <tr>
                    <th scope="col">Member</th>
                    <th scope="col">Role</th>
                    @if (isOwner)
                    {
                        <th scope="col"></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var member in Snapshot.Members)
                {
                    <tr>
                        <td>
                            <UserAvatar UserId="member.UserId" />
                            <span>@member.UserName</span>
                        </td>
                        <td>
                            @if (member.UserId == Snapshot.OwnerUserId)
                            {
                                <span class="badge badge-owner">Owner</span>
                            }
                            else if (member.IsAdmin)
                            {
                                <span class="badge badge-admin">Admin</span>
                            }
                        </td>
                        @if (isOwner)
                        {
                            <td>
                                @if (member.UserId != Snapshot.OwnerUserId)
                                {
                                    <button class="button button-submit" disabled="@Busy" @onclick="() => SetAdminAsync(member.UserId, !member.IsAdmin)">
                                        @(member.IsAdmin ? "Remove admin" : "Make admin")
                                    </button>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<CurrencySettings Snapshot="Snapshot" UserId="UserId" Busy="Busy" Run="Run" />

@if (isAdmin)
{
    <section>
        <h2>
            Administration
        </h2>
        <div @key="attempts">
            <div class="form form-switch">
                <input type="checkbox" id="new-times" checked="@(Snapshot.AllowNewTimes)" disabled="@Busy"
                       @onchange="e => SetNewTimesAsync((bool)e.Value!)" />
                <label for="new-times">Open for new time suggestions</label>
            </div>
            <div class="form form-switch">
                <input type="checkbox" id="participation" checked="@(Snapshot.AllowNewUsers)" disabled="@Busy"
                       @onchange="e => SetParticipationAsync((bool)e.Value!)" />
                <label for="participation">Open for new members</label>
            </div>
            <div class="form form-switch">
                <input type="checkbox" id="schedule-enabled" checked="@(!Snapshot.IsScheduleDisabled)" disabled="@Busy"
                       @onchange="e => SetTabsAsync((bool)e.Value!, !Snapshot.IsExpensesDisabled)" />
                <label for="schedule-enabled">Schedule enabled</label>
            </div>
            <div class="form form-switch">
                <input type="checkbox" id="expenses-enabled" checked="@(!Snapshot.IsExpensesDisabled)" disabled="@Busy"
                       @onchange="e => SetTabsAsync(!Snapshot.IsScheduleDisabled, (bool)e.Value!)" />
                <label for="expenses-enabled">Expenses enabled</label>
            </div>
        </div>

        <div class="form">
            A disabled tab stays visible but cannot be changed. Disabling the schedule closes the poll and confirms the picked time.
        </div>

        <form @onsubmit="UpdateDetailsAsync">
            <div class="form">
                <input placeholder="Title" maxlength="@ArrangementRules.TitleMaxLength" @bind="title" />
            </div>
            <div class="form">
                <textarea rows="3" placeholder="Description" maxlength="@ArrangementRules.DescriptionMaxLength" @bind="description"></textarea>
            </div>
            @if (detailsError != null)
            {
                <div class="warning">@detailsError</div>
            }
            <button type="submit" class="button button-submit" disabled="@Busy">Save details</button>
        </form>
    </section>
}

@if (isOwner)
{
    <section>
        <button class="button button-delete" disabled="@(Busy || deleting)" @onclick="DeleteAsync">Delete arrangement</button>
        @if (deleteError != null)
        {
            <div class="warning">@deleteError</div>
        }
    </section>
}
else if (me != null)
{
    <section>
        <button class="button button-delete" disabled="@Busy" @onclick="LeaveAsync">Leave arrangement</button>
        <p class="secondary">Any schedule votes will be removed.<br />If you have paid or shared an expense, you cannot leave and the your participation remains recorded.</p>
    </section>
}

@code {
    private string title = string.Empty;
    private string description = string.Empty;
    private string? shownTitle;
    private string? shownDescription;
    private string? detailsError;
    private string? deleteError;
    private bool deleting;
    private bool copied;
    private bool copyFailed;
    private int attempts;

    /// <summary>
    /// The arrangement.
    /// </summary>
    [Parameter, EditorRequired]
    public ArrangementSnapshot Snapshot { get; set; } = null!;

    /// <summary>
    /// The viewer's user ID.
    /// </summary>
    [Parameter, EditorRequired]
    public Guid UserId { get; set; }

    /// <summary>
    /// Whether a command is in progress.
    /// </summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>
    /// Runs a command: the method, the path under the arrangement or <b>null</b> for the arrangement itself, and the body.
    /// </summary>
    [Parameter, EditorRequired]
    public Func<HttpMethod, string?, object?, Task<bool>> Run { get; set; } = null!;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        // Keep what the user is typing unless someone actually changed the details.
        if (Snapshot.Title != shownTitle || Snapshot.Description != shownDescription)
        {
            title = shownTitle = Snapshot.Title;
            description = shownDescription = Snapshot.Description;
        }
    }

    private async Task SetParticipationAsync(bool isOpen)
    {
        await Run(HttpMethod.Put, "participation", new SetParticipationRequest(isOpen));
        Redraw();
    }

    private async Task SetNewTimesAsync(bool isOpen)
    {
        await Run(HttpMethod.Put, "new-times", new SetAllowNewTimesRequest(isOpen));
        Redraw();
    }

    private async Task SetTabsAsync(bool isScheduleEnabled, bool isExpensesEnabled)
    {
        await Run(HttpMethod.Put, "tabs", new SetTabsRequest(isScheduleEnabled, isExpensesEnabled));
        Redraw();
    }

    private async Task LeaveAsync()
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Leave \"{Snapshot.Title}\"?") && await Run(HttpMethod.Post, "leave", null))
        {
            Navigation.NavigateTo(string.Empty);
        }
    }

    private void Redraw()
    {
        // Redraw the switches from the snapshot, also when the change was refused or made no difference.
        attempts++;
    }

    private Task SetAdminAsync(Guid memberUserId, bool isAdmin)
    {
        return Run(HttpMethod.Put, $"members/{memberUserId}/admin", new SetAdminRequest(isAdmin));
    }

    private async Task UpdateDetailsAsync()
    {
        detailsError = ArrangementRules.ValidateDetails(ArrangementRules.NormalizeText(title), ArrangementRules.NormalizeText(description));
        if (detailsError == null)
        {
            await Run(HttpMethod.Put, null, new UpdateArrangementDetailsRequest(title, description));
        }
    }

    private async Task DeleteAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete \"{Snapshot.Title}\" and everything in it? This cannot be undone."))
        {
            return;
        }

        deleting = true;
        deleteError = await Api.SendAsync(HttpMethod.Delete, $"api/arrangements/{Snapshot.Id}");
        deleting = false;
        if (deleteError == null)
        {
            Navigation.NavigateTo(string.Empty);
        }
    }

    private async Task CopyAsync(string link)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", link);
            copied = true;
        }
        catch (JSException)
        {
            // The clipboard API needs HTTPS or localhost.
            copyFailed = true;
        }
    }
}
