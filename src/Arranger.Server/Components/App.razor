<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon_faemiyah.png" />
    <meta property="og:site_name" content="Arranger" />
    <meta property="og:title" content="Arranger" />
    <meta property="og:description" content="Arrange events: scheduling, expenses and participant management." />
    <meta property="og:image" content="@OgImageUrl" />
    <meta property="og:type" content="website" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/timezone.js"]"></script>
</body>

</html>

@code {
    private static readonly IComponentRenderMode InteractiveWebAssemblyWithoutPrerendering = new InteractiveWebAssemblyRenderMode(prerender: false);

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveWebAssemblyWithoutPrerendering : null;

    // Open Graph requires an absolute URL; derived from the request so it follows whatever host the app is served on.
    private string OgImageUrl =>
        $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}{HttpContext.Request.PathBase}/logo_arranger.png";
}
