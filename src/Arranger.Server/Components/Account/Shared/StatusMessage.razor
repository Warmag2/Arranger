@if (!string.IsNullOrEmpty(Message))
{
    <div class="@(IsError ? "error" : "success")" role="alert">
        @Message
    </div>
}

@code {
    /// <summary>
    /// Whether the message is shown as an error instead of a success.
    /// </summary>
    [Parameter]
    public bool IsError { get; set; }

    /// <summary>
    /// The message. Nothing is shown when it is empty.
    /// </summary>
    [Parameter]
    public string? Message { get; set; }
}
