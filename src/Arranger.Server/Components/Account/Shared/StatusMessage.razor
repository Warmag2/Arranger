@if (!string.IsNullOrEmpty(Message))
{
    var statusMessageClass = Message.StartsWith("Error", StringComparison.Ordinal) ? "error" : "success";
    <div class="@statusMessageClass" role="alert">
        @Message
    </div>
}

@code {
    /// <summary>
    /// The message. Messages starting with "Error" are shown as errors.
    /// </summary>
    [Parameter]
    public string? Message { get; set; }
}
