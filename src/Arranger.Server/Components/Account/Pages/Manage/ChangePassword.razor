@page "/Account/Manage"
@page "/Account/Manage/ChangePassword"

@inject AccountService AccountService

<PageTitle>Change password</PageTitle>

<h1>Change password</h1>
<StatusMessage Message="@message" IsError="@isError" />
<section>
    <EditForm Model="Input" FormName="change-password" OnValidSubmit="ChangePasswordAsync" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary role="alert" />
        <FormField Label="Current password" Type="password" @bind-Value="Input.OldPassword" Autocomplete="current-password" Placeholder="Enter the old password" />
        <FormField Label="New password" Type="password" @bind-Value="Input.NewPassword" Autocomplete="new-password" Placeholder="Enter the new password" />
        <FormField Label="Confirm new password" Type="password" @bind-Value="Input.ConfirmPassword" Autocomplete="new-password" Placeholder="Enter the new password" />
        <button type="submit" class="button button-submit">Update password</button>
    </EditForm>
</section>

@code {
    private bool isError;
    private string? message;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task ChangePasswordAsync()
    {
        var userId = AccountService.GetUserId(HttpContext.User);
        isError = true;
        if (userId == null)
        {
            message = "Error: Unknown user.";
            return;
        }

        var result = await AccountService.ChangePasswordAsync(userId.Value, Input.OldPassword, Input.NewPassword, HttpContext.RequestAborted);
        Input = new();

        if (result.Status != AccountStatus.Success || result.User == null)
        {
            message = result.Status switch
            {
                AccountStatus.WrongPassword => "Error: The current password is wrong.",
                AccountStatus.InvalidPassword => "Error: Invalid new password.",
                AccountStatus.Conflict => "Error: Your account was changed at the same time. Please try again.",
                _ => "Error: Changing the password failed.",
            };
            return;
        }

        // The security stamp changed, so the current cookie must be replaced or it would be rejected too.
        var current = await HttpContext.AuthenticateAsync(CookieAuthenticationDefaults.AuthenticationScheme);
        await AccountService.SignInAsync(HttpContext, result.User, current.Properties?.IsPersistent ?? false);

        isError = false;
        message = "Your password has been changed. Other sessions will be signed out within a few minutes.";
    }

    private sealed class InputModel
    {
        [Required]
        [DataType(DataType.Password)]
        [Display(Name = "Current password")]
        public string OldPassword { get; set; } = string.Empty;

        [Required]
        [StringLength(AccountRules.PasswordMaxLength, ErrorMessage = AccountMessages.LengthRange, MinimumLength = AccountRules.PasswordMinLength)]
        [DataType(DataType.Password)]
        [Display(Name = "New password")]
        public string NewPassword { get; set; } = string.Empty;

        [DataType(DataType.Password)]
        [Display(Name = "Confirm new password")]
        [Compare(nameof(NewPassword), ErrorMessage = "The new password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
