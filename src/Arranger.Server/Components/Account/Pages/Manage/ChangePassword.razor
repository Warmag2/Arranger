@page "/Account/Manage"
@page "/Account/Manage/ChangePassword"

@inject AccountService AccountService

<PageTitle>Change password</PageTitle>

<h1>Change password</h1>
<StatusMessage Message="@message" />
<section>
    <EditForm Model="Input" FormName="change-password" OnValidSubmit="ChangePasswordAsync" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary role="alert" />
        <div class="form">
            <label for="Input.OldPassword">Current password</label>
            <InputText type="password" @bind-Value="Input.OldPassword" id="Input.OldPassword" autocomplete="current-password" aria-required="true" placeholder="Enter the old password" />
            <ValidationMessage For="() => Input.OldPassword" />
        </div>
        <div class="form">
            <label for="Input.NewPassword">New password</label>
            <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword" autocomplete="new-password" aria-required="true" placeholder="Enter the new password" />
            <ValidationMessage For="() => Input.NewPassword" />
        </div>
        <div class="form">
            <label for="Input.ConfirmPassword">Confirm new password</label>
            <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder="Enter the new password" />
            <ValidationMessage For="() => Input.ConfirmPassword" />
        </div>
        <button type="submit" class="button button-submit">Update password</button>
    </EditForm>
</section>

@code {
    private string? message;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task ChangePasswordAsync()
    {
        var userId = AccountService.GetUserId(HttpContext.User);
        if (userId == null)
        {
            message = "Error: Unknown user.";
            return;
        }

        var result = await AccountService.ChangePasswordAsync(userId.Value, Input.OldPassword, Input.NewPassword, HttpContext.RequestAborted);
        Input = new();

        if (result.Status != AccountStatus.Success || result.User == null)
        {
            message = result.Status switch
            {
                AccountStatus.WrongPassword => "Error: The current password is wrong.",
                AccountStatus.InvalidPassword => "Error: Invalid new password.",
                AccountStatus.Conflict => "Error: Your account was changed at the same time. Please try again.",
                _ => "Error: Changing the password failed.",
            };
            return;
        }

        // The security stamp changed, so the current cookie must be replaced or it would be rejected too.
        var current = await HttpContext.AuthenticateAsync(CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            AccountService.CreatePrincipal(result.User),
            new AuthenticationProperties { IsPersistent = current.Properties?.IsPersistent ?? false });

        message = "Your password has been changed. Other sessions will be signed out within a few minutes.";
    }

    private sealed class InputModel
    {
        [Required]
        [DataType(DataType.Password)]
        [Display(Name = "Current password")]
        public string OldPassword { get; set; } = string.Empty;

        [Required]
        [StringLength(AccountRules.PasswordMaxLength, ErrorMessage = "The {0} must be at least {2} and at most {1} characters long.", MinimumLength = AccountRules.PasswordMinLength)]
        [DataType(DataType.Password)]
        [Display(Name = "New password")]
        public string NewPassword { get; set; } = string.Empty;

        [DataType(DataType.Password)]
        [Display(Name = "Confirm new password")]
        [Compare(nameof(NewPassword), ErrorMessage = "The new password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
