@page "/Account/Register"
@attribute [EnableRateLimiting(RateLimitingPolicies.Account)]

@inject AccountService AccountService
@inject NavigationManager NavigationManager
@inject IOptions<RegistrationOptions> RegistrationOptions

<PageTitle>Register</PageTitle>

<h1>Register</h1>

@if (!RegistrationOptions.Value.Enabled)
{
    <p>Registration is closed.</p>
    return;
}

<section>
    <StatusMessage Message="@errorMessage" />
    <EditForm Model="Input" method="post" OnValidSubmit="RegisterUserAsync" FormName="register">
        <DataAnnotationsValidator />
        <ValidationSummary role="alert" />
        <InputText type="hidden" @bind-Value="Input.TimeZoneId" data-browser-timezone />
        <div class="form">
            <label for="Input.UserName">Username</label>
            <InputText @bind-Value="Input.UserName" id="Input.UserName" autocomplete="username" aria-required="true" placeholder="username" />
            <ValidationMessage For="() => Input.UserName" />
        </div>
        <div class="form">
            <label for="Input.Password">Password</label>
            <InputText type="password" @bind-Value="Input.Password" id="Input.Password" autocomplete="new-password" aria-required="true" placeholder="password" />
            <ValidationMessage For="() => Input.Password" />
        </div>
        <div class="form">
            <label for="Input.ConfirmPassword">Confirm password</label>
            <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder="password" />
            <ValidationMessage For="() => Input.ConfirmPassword" />
        </div>
        <button type="submit" class="button button-submit">Register</button>
    </EditForm>
</section>

@code {
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task RegisterUserAsync()
    {
        if (!RegistrationOptions.Value.Enabled)
        {
            return;
        }

        var result = await AccountService.RegisterAsync(Input.UserName, Input.Password, Input.TimeZoneId, HttpContext.RequestAborted);
        if (result.Status != AccountStatus.Success || result.User == null)
        {
            errorMessage = result.Status switch
            {
                AccountStatus.UserNameTaken => "Error: That username is already taken.",
                AccountStatus.InvalidUserName => "Error: Invalid username.",
                AccountStatus.InvalidPassword => "Error: Invalid password.",
                _ => "Error: Registration failed.",
            };
            return;
        }

        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, AccountService.CreatePrincipal(result.User));
        NavigationManager.NavigateTo(ReturnUrls.ToLocalPath(ReturnUrl));
    }

    private sealed class InputModel
    {
        [Required]
        [RegularExpression(AccountRules.UserNamePattern, ErrorMessage = "The username must be 3-32 characters: letters A-Z, digits, '.', '_' or '-'.")]
        [Display(Name = "Username")]
        public string UserName { get; set; } = string.Empty;

        [Required]
        [StringLength(AccountRules.PasswordMaxLength, ErrorMessage = "The {0} must be at least {2} and at most {1} characters long.", MinimumLength = AccountRules.PasswordMinLength)]
        [DataType(DataType.Password)]
        [Display(Name = "Password")]
        public string Password { get; set; } = string.Empty;

        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare(nameof(Password), ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;

        public string? TimeZoneId { get; set; }
    }
}
